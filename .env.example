APP_ENV=development
DEMO_MODE=true
ALLOW_REGISTRATION=false
DATABASE_URL=sqlite:////data/vantage_iq.db
UPLOAD_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VITE_API_URL=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
PUBLIC_APP_URL=http://localhost:8080
AUTH_ACTION_TOKEN_TTL_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true
# Production only: set a strong secret, MySQL URL, and absolute CA certificate path.
SECRET_KEY=
DATABASE_SSL_CA=
SESSION_COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
FORWARDED_ALLOW_IPS=127.0.0.1
WEB_CONCURRENCY=1
AUTO_MIGRATE=true
# Production deployment only: path to the host-mounted CA certificate file.
DATABASE_SSL_CA_HOST_PATH=
